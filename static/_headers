# Header keamanan untuk semua halaman.
# File ini otomatis dibaca oleh Netlify. Jika deploy di Vercel/Cloudflare Pages,
# pindahkan aturan yang sama ke vercel.json / _headers sesuai platform (lihat README).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-XSS-Protection: 1; mode=block

# Cache agresif untuk aset statis hash-versioned yang dihasilkan Gatsby
/static/*
  Cache-Control: public, max-age=31536000, immutable

/page-data/*
  Cache-Control: public, max-age=31536000, immutable
