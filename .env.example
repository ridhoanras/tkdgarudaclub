# Salin file ini menjadi .env.development dan .env.production, lalu isi sesuai kebutuhan.
# JANGAN PERNAH commit file .env.* yang berisi nilai asli ke Git.

# Jika nanti menambahkan Google Analytics / GTM:
# GATSBY_GA_MEASUREMENT_ID=G-XXXXXXX

# Jika form kontak dipindah dari Netlify Forms ke penyedia lain (mis. Web3Forms):
# GATSBY_FORM_ENDPOINT=https://api.web3forms.com/submit
# FORM_ACCESS_KEY=isi-hanya-di-server-jangan-di-kode-client
